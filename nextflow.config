conda.enabled = true
conda.cacheDir = "${System.getenv('HOME')}/.nextflow/conda"
conda.createTimeout = '1h'

process {
    conda = "${projectDir}/config/environment_epiexpress.yml"

    withName: DIFFERENTIAL_EXPRESSION {
        conda = "${projectDir}/config/environment_hawas.yml"
    }
    withName: GO_ENRICHMENT {
        conda = "${projectDir}/config/environment_hawas.yml"
    }
    withName: DISGENET {
        conda = "${projectDir}/config/environment_hawas.yml"
    }
}

profiles {
    conda {
        process.conda = "${projectDir}/config/environment_epiexpress.yml"
        process.withName.DIFFERENTIAL_EXPRESSION.conda = "${projectDir}/config/environment_hawas.yml"
        process.withName.GO_ENRICHMENT.conda = "${projectDir}/config/environment_hawas.yml"
        process.withName.DISGENET.conda = "${projectDir}/config/environment_hawas.yml"
    }
}
