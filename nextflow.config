conda.enabled = true
conda.useMamba = true
conda.cacheDir = "${System.getenv('HOME')}/.nextflow/conda"
conda.createTimeout = '1h'

process {
    conda = "/home/dhecker/miniconda3/envs/epiexpress"

    withName: DIFFERENTIAL_EXPRESSION {
        conda = "/home/dhecker/miniconda3/envs/hawas"
    }
    withName: GO_ENRICHMENT {
        conda = "/home/dhecker/miniconda3/envs/hawas"
    }
    withName: DISGENET {
        conda = "/home/dhecker/miniconda3/envs/hawas"
    }
}

profiles {
    conda {
        process.conda = "/home/dhecker/miniconda3/envs/epiexpress"
        process.withName.DIFFERENTIAL_EXPRESSION.conda = "/home/dhecker/miniconda3/envs/hawas"
        process.withName.GO_ENRICHMENT.conda = "/home/dhecker/miniconda3/envs/hawas"
        process.withName.DISGENET.conda = "/home/dhecker/miniconda3/envs/hawas"
    }
}

